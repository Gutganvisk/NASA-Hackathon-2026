# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais do Copernicus CDSE

CDSE_CLIENT_ID=sh-seu-client-id-aqui
CDSE_CLIENT_SECRET=seu-client-secret-aqui
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SH_URL=https://sh.dataspace.copernicus.eu
